{
  "name": "all4pay-saas",
  "version": "0.1.0",
  "private": true,
  "description": "all4pay — ERP + sistema de gestão financeira. Construído sobre o Design System all4pay (Round Treasury).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "smoke": "node --experimental-strip-types --loader ./scripts/ts-alias-loader.mjs ./scripts/engine-smoke.mts",
    "corpus": "node --experimental-strip-types --loader ./scripts/ts-alias-loader.mjs ./scripts/assistant-corpus.mts",
    "values": "node --experimental-strip-types --loader ./scripts/ts-alias-loader.mjs ./scripts/assistant-values.mts",
    "edge": "node --experimental-strip-types --loader ./scripts/ts-alias-loader.mjs ./scripts/assistant-edge.mts",
    "kb": "node --experimental-strip-types --loader ./scripts/ts-alias-loader.mjs ./scripts/assistant-kb-coverage.mts",
    "tz": "TZ=America/Sao_Paulo node --experimental-strip-types --loader ./scripts/ts-alias-loader.mjs ./scripts/tz-boundary.mts",
    "audit": "TZ=America/Sao_Paulo node --experimental-strip-types --loader ./scripts/ts-alias-loader.mjs ./scripts/engine-audit.mts",
    "test": "npm run typecheck && npm run smoke && npm run corpus && npm run values && npm run edge && npm run kb && npm run tz && npm run audit && npm run consistencia && npm run reconciliacao && npm run ia-eval && npm run esquema",
    "consistencia": "TZ=America/Sao_Paulo node --experimental-strip-types --loader ./scripts/ts-alias-loader.mjs ./scripts/consistencia.mts",
    "reconciliacao": "TZ=America/Sao_Paulo node --experimental-strip-types --loader ./scripts/ts-alias-loader.mjs ./scripts/reconciliacao.mts",
    "mobile": "node ./scripts/mobile.mjs",
    "fluxos": "node ./scripts/fluxos-telefone.mjs",
    "ia-eval": "TZ=America/Sao_Paulo node --experimental-strip-types --loader ./scripts/ts-alias-loader.mjs ./scripts/ia-eval.mts",
    "esquema": "node --experimental-strip-types ./scripts/esquema.mts",
    "esquema:sync": "node ./scripts/esquema-sync.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
