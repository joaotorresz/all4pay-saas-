# Supabase — copy to .env.local and fill in your project values.
# Found in the Supabase dashboard under Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only key — NEVER expose to the client / commit a real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Demonstration mode. When "true" (or when the Supabase vars above are
# absent) the dashboard renders deterministic seed data with a
# "Demonstração" badge. Set to "false" with real Supabase vars to go live.
NEXT_PUBLIC_ALL4PAY_DEMO=true
