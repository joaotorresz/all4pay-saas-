# Supabase — copy to .env.local and fill in your project values.
# Found in the Supabase dashboard under Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only key — NEVER expose to the client / commit a real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Demonstration mode. When "true" (or when the Supabase vars above are
# absent) the dashboard renders deterministic seed data with a
# "Demonstração" badge. Set to "false" with real Supabase vars to go live.
NEXT_PUBLIC_ALL4PAY_DEMO=true

# Protects the scheduled Financial OS runner (/api/financial-os/run).
# When set, Vercel Cron must send `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=

# ---- Notificações reais (server-side; usadas pelo runner /api/financial-os/run) ----
# WhatsApp via Twilio (sandbox para começar, depois número aprovado).
# Sem estas três, o WhatsApp permanece em modo simulado.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Destino padrão dos alertas quando a regra não traz um telefone:
ALERTS_WHATSAPP_TO=
# Templates aprovados (fora da janela de 24h só sai template). UM POR FINALIDADE;
# ContentSid (HX...) criado no Twilio Content. Sem eles o envio é free-form
# (sandbox/janela). Detalhe das variáveis em src/core/financial-os/notifications.server.ts.
# ⚠️ TWILIO_TEMPLATE_COBRANCA_SID (o modelo único) foi APOSENTADO: cada tom da
# régua tem o seu.
#   Cobrança (1 cliente · 2 credor · 3 valor · 4 vencimento · 5 dias de atraso):
TWILIO_TEMPLATE_COBRANCA_LEMBRETE_SID=
TWILIO_TEMPLATE_COBRANCA_ATRASO_SID=
TWILIO_TEMPLATE_COBRANCA_FORMAL_SID=
#   Avisos de uma linha (variável 1 = o texto) — também a RESERVA dos organizados:
TWILIO_TEMPLATE_RESUMO_SID=
TWILIO_TEMPLATE_LEMBRETE_PAGAR_SID=
TWILIO_TEMPLATE_ALERTA_SID=
TWILIO_TEMPLATE_FECHAMENTO_SID=
#   Avisos organizados (resumo do dia: 8 variáveis; os outros: 6):
TWILIO_TEMPLATE_RESUMO_DIA_SID=
TWILIO_TEMPLATE_LEMBRETE_PAGAR_DIA_SID=
TWILIO_TEMPLATE_ALERTA_DIA_SID=
TWILIO_TEMPLATE_FECHAMENTO_MES_SID=
#   Fluxos que o cliente monta em Automações (1 título · 2 resumo):
TWILIO_TEMPLATE_FLUXO_SID=
#   Lembrete de quem não terminou o cadastro:
TWILIO_TEMPLATE_CADASTRO_SID=
#   Código que confirma o celular da Quattro AI (categoria Autenticação; 1 = código):
TWILIO_TEMPLATE_CODIGO_WHATSAPP_SID=

# E-mail via Resend (só a chave; remetente verificado no seu domínio).
RESEND_API_KEY=
ALERTS_EMAIL_FROM=all4pay <alertas@seu-dominio.com>
# Cobrança no nome da empresa: domínio da plataforma VERIFICADO no Resend.
# O e-mail sai de "Empresa" <cobrancas+<id>@domínio>, com resposta para a empresa.
# Sem ele, a cobrança sai por ALERTS_EMAIL_FROM.
COBRANCA_EMAIL_DOMINIO=

# ---- Interruptores do WhatsApp (todos DESLIGADOS por padrão) ----
# Aprovar pagamento pelo WhatsApp, pelo MESMO gatilho da Central.
WHATSAPP_APROVACAO=
# Quattro AI no WhatsApp (só leitura; o celular é confirmado por código).
WHATSAPP_IA=
# Lembretes a quem começou o cadastro e não terminou (/api/cadastro/lembretes/run).
CADASTRO_LEMBRETES=
# Agentes da Quattro AI (cobrança, conciliação, contas a pagar, caixa, fechamento).
# Sem AGENTES=ligado nenhum agente trabalha, mesmo ligado pela empresa.
AGENTES=

# ---- Caixa de entrada de contas a pagar por E-MAIL (webhook inbound) ----
# DESLIGADA por padrão: sem CAIXA_EMAIL=ligado a rota /api/caixa-email/entrada
# responde 503. Para ligar: provedor (formato inbound do Postmark) apontando
# para a rota com o segredo como senha do Basic auth (ou ?segredo=), o mesmo
# CAIXA_EMAIL_SEGREDO aqui, e a migration 20261001150000 aplicada.
# NEXT_PUBLIC_CAIXA_EMAIL_DOMINIO é o domínio do endereço que a tela mostra
# (contas+<token>@<domínio>); sem ele, a tela diz que falta configurar.
CAIXA_EMAIL=
CAIXA_EMAIL_SEGREDO=
NEXT_PUBLIC_CAIXA_EMAIL_DOMINIO=

# ---- Maquininha PINBANK (webhook Compra.*) ----
# DESLIGADA por padrão: sem PINBANK_WEBHOOK=ligado a rota /api/pinbank/webhook
# responde 503. Para ligar: migration 20261005120000 aplicada e o webhook
# cadastrado no suporte da Pinbank (URL + eventos Compra.*). A assinatura é
# Ed25519; PINBANK_WEBHOOK_JWKS guarda a resposta de
# https://pinbank.com.br/webhook/signing-key (recomendado — sem ela a rota busca
# a chave e guarda por uma hora). Chave PÚBLICA: não é segredo. JSON ilegível
# aqui responde 503 (a Pinbank reenvia) até alguém consertar — nunca 401.
PINBANK_WEBHOOK=
PINBANK_WEBHOOK_JWKS=
# PINBANK_SIGNING_KEY_URL=https://pinbank.com.br/webhook/signing-key
#
# ---- Saída fixa para a Pinbank (os 2 IPs que ela libera) ----
# Toda chamada do servidor à Pinbank passa por src/lib/pinbank/saida.ts e, com
# estas variáveis, por um dos DOIS servidores da AWS (infra/saida-pinbank/).
# O valor de cada uma é o que `sudo quattro-saida-url` mostra no servidor:
# http://usuario:senha@IP:31280. ⚠️ SEGREDO: só Production, marcar Sensitive
# (preview não fala com a Pinbank). Sem elas a chamada sai direto da Vercel,
# por IP que muda — e a rota /api/admin/saida-fixa diz isso.
PINBANK_SAIDA_1=
PINBANK_SAIDA_2=
# Só se os servidores usarem TLS na entrada (https://): a CA que os assina.
# PINBANK_SAIDA_CA=

# ---- API da Pinbank (token OAuth2 + métodos Encrypted), SÓ LEITURA ----
# Usada pelo extrato consolidado de vendas (ExtratoPos): a data real do repasse
# e a taxa. Sai pela saída fixa acima. Teste: GET /api/admin/pinbank-extrato.
# AMBIENTE escolhe a base (dev | producao) — nunca uma URL livre.
# USUARIO = o UserName da credencial ("API Key"); ORIGEM = o RequestOrigin,
# que a Pinbank informou ser SEMPRE 5 (13/10/2026). Vazio, o cabeçalho não vai
# e a Pinbank recusa com "[Header]RequestOrigin null ou vazio".
# ⚠️ CHAVE = o KeyValue ("Senha"): é a senha do token E a chave da cifra AES.
# SEGREDO: só Production, marcar Sensitive; nunca colar em chat ou e-mail.
PINBANK_API_AMBIENTE=
PINBANK_API_USUARIO=
PINBANK_API_CHAVE=
PINBANK_API_ORIGEM=5
PINBANK_CODIGO_CANAL=
# A CONFERÊNCIA extrato × sistema (botão "Conferir com o extrato" no cartão da
# maquininha, em Integrações; POST /api/pinbank/conferencia). DESLIGADA por
# padrão: sem PINBANK_CONFERENCIA=ligado a rota se recusa. E mesmo ligada, só
# roda com PINBANK_API_AMBIENTE=producao — com a credencial de teste a
# conferência compararia as vendas da empresa com vendas de teste. Ligar só
# depois de conferir o extrato de PRODUÇÃO contra uma venda real — e só quando
# existirem (1) o limite DURÁVEL de chamadas por empresa no servidor (a espera
# de 60 s de hoje vale por instância: outra instância começa do zero) e (2) o
# código do estabelecimento (EC) visível e auditado no /admin. As duas pedem
# migration — decisões D2, D4 e D10 em docs/rodada-10/conferencia.md.
PINBANK_CONFERENCIA=
# Cobrança por Pix e boleto pela conta Pinbank da empresa (/api/pinbank/cobranca).
# DESLIGADA por padrão: sem PINBANK_COBRANCA=ligado o botão some e a rota se
# recusa. Mesmo ligada, só roda com PINBANK_API_AMBIENTE=producao. Só CRIA
# cobrança para a empresa receber: nenhum caminho paga ou transfere.
PINBANK_COBRANCA=
# Multa e juros que a empresa configura (Integrações › maquininha) vão no
# boleto da Pinbank. DESLIGADA por padrão: sem PINBANK_BOLETO_ENCARGOS=ligado o
# boleto sai com Juros e Multa zerados. A unidade dos campos ainda não foi
# confirmada pela Pinbank (hipótese: centésimos de percentual, 2% = 200).
PINBANK_BOLETO_ENCARGOS=
# Pix atualizado no link de pagamento: depois do vencimento, com multa e juros
# registrados no boleto, a página gera um Pix com o valor do dia (vale até 23:59).
# DESLIGADO por padrão: sem PINBANK_PIX_ATUALIZADO=ligado a página só oferece o
# boleto depois que os encargos começam. Depende de PINBANK_BOLETO_ENCARGOS.
PINBANK_PIX_ATUALIZADO=
# Mensalidade do ERP cobrada por Pix ou boleto pela conta Pinbank DA QUATTRO
# (/api/mensalidade/cobranca). DESLIGADA por padrão: sem MENSALIDADE_PINBANK=ligado
# o cliente não vê o botão de pagar. Exige PINBANK_API_AMBIENTE=producao e o
# código da conta da Quattro que RECEBE (inteiro, dado pela Pinbank). O código
# mora só aqui: o banco não o guarda.
MENSALIDADE_PINBANK=
PINBANK_QUATTRO_CODIGO_CLIENTE=

# ---- Document Intelligence / OCR (Caixa de Entrada Financeira) ----
# Visão do Claude lê boletos/notas/comprovantes (imagem/PDF) e extrai os campos.
# OPCIONAL: sem a chave, imagem E PDF caem no OCR LOCAL gratuito (Tesseract.js +
# pdf.js, rodam no navegador) — precisão menor, entram como "revisão". Extratos
# OFX/CSV já rodam 100% local pelo onboarding inteligente. Server-side.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Endereço da área da plataforma (painel do dono: planos, cobrança, acessos,
# suporte). Com ele, `/admin` só responde ali (o app manda para lá com 308) e
# ali só responde o painel e a porta de entrada. Vazio = como antes, /admin no
# próprio endereço. LIGUE só depois de o DNS e o domínio na Vercel responderem.
ADMIN_HOST=
# Endereço do app dos clientes visto da área da plataforma — para onde o
# "logar como" leva a sessão do cliente. Vazio = `admin.<domínio>` vira
# `app.<domínio>` (ex.: admin.quattro.finance → app.quattro.finance).
APP_HOST=

# ---- Entrar com Google pelo NOSSO domínio (opcional) ----
# Com as duas, a ida passa por /api/auth/google/inicio e a tela do Google mostra
# a Quattro. Sem elas, segue o caminho do Supabase. O SECRET é SEGREDO.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- NFS-e pela Focus NFe ----
# AMBIENTE: homologacao | producao (padrão homologacao). Os tokens são SEGREDO.
# EMITENTES é a RESERVA em JSON { "<org_id>": { cnpj, inscricaoMunicipal, ... } }:
# a tabela nfse_emitentes vence (formato completo em src/lib/focusnfe.ts).
FOCUS_NFE_AMBIENTE=
FOCUS_NFE_TOKEN_HOMOLOGACAO=
FOCUS_NFE_TOKEN_PRODUCAO=
FOCUS_NFE_EMITENTES=

# ---- Cobrança pela conta bancária do cliente (Inter e Itaú diretos) ----
# DESLIGADA por padrão: sem COBRANCA_BANCO=ligado a conexão e a emissão se recusam.
# A credencial de cada empresa é cifrada com a CHAVE MESTRA (AES-256-GCM). SEGREDO:
# trocar a chave torna ilegíveis as credenciais já guardadas.
COBRANCA_BANCO=
COBRANCA_CHAVE_MESTRA=
# Inter (teste e piloto): AMBIENTE sandbox | producao; certificado e chave em PEM
# (ou PEM em base64). CLIENT_SECRET e CHAVE_PRIVADA são SEGREDO.
INTER_AMBIENTE=
INTER_CLIENT_ID=
INTER_CLIENT_SECRET=
INTER_CERTIFICADO=
INTER_CHAVE_PRIVADA=
INTER_CONTA_CORRENTE=
# Itaú (teste no sandbox, /api/admin/itau-teste): mesmas regras; certificado
# obrigatório em produção. Os cinco últimos são a conta que recebe.
ITAU_AMBIENTE=
ITAU_CLIENT_ID=
ITAU_CLIENT_SECRET=
ITAU_CERTIFICADO=
ITAU_CHAVE_PRIVADA=
ITAU_AGENCIA=
ITAU_CONTA=
ITAU_DAC=
ITAU_CARTEIRA=
ITAU_CHAVE_PIX=

# ---- Editor do design system (Administração › Design system) ----
# "Salvar no sistema" abre um PR com o tokens.json. TOKEN: Contents + Pull
# requests write neste repositório (SEGREDO). Sem ele a tela oferece "Baixar".
GITHUB_TOKEN_DESIGN=
# GITHUB_REPO_DESIGN=joaotorresz/all4pay-saas-
# GITHUB_BASE_DESIGN=main

# ---- Edge Functions do Supabase (NÃO vão na Vercel) ----
# Estas são lidas pelas funções em supabase/functions/ e se configuram como
# secrets do projeto Supabase (Edge Functions › Secrets), não aqui:
#   PLUGGY_CLIENT_ID · PLUGGY_CLIENT_SECRET · PLUGGY_WEBHOOK_SECRET (Open Finance)
#   RESEND_FROM · RESEND_REPLY_TO · SITE_URL
#   WHATSAPP_TOKEN · WHATSAPP_PHONE_NUMBER_ID · WHATSAPP_TEMPLATE_NAME
#   SUPABASE_URL · SUPABASE_ANON_KEY (o Supabase injeta sozinho)
